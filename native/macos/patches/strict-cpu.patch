diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StrictNative.h b/Source/Core/Core/PowerPC/StaticRecomp/StrictNative.h
new file mode 100644
index 0000000..9ecb5a8
--- /dev/null
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StrictNative.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace Melee
+{
+// Read once so every CPU path uses the same launch-time setting.
+inline bool StrictNativeEnabled()
+{
+  static const bool enabled = [] {
+    const char* value = std::getenv("MELEE_STRICT_NATIVE");
+    return value && value[0] == '1';
+  }();
+  return enabled;
+}
+
+[[noreturn]] inline void RejectCPUFallback(const char* path, std::uint32_t pc)
+{
+  std::fprintf(stderr, "[staticrecomp] STRICT FAILURE: %s at 0x%08X\n", path, pc);
+  std::fflush(stderr);
+  std::_Exit(88);
+}
+}  // namespace Melee

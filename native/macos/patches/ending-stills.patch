+// Ending stills decode to YUV buffers whose pixels depend on the decoder.
+// Name their replacements from the original compressed file instead.
+std::string GetEndingStillName(const TextureInfo &texture_info)
+{
+  if (!std::getenv("MODERNGEKKO_STATICRECOMP") ||
+      texture_info.GetTextureFormat() != TextureFormat::I8 ||
+      SConfig::GetInstance().GetGameID() != "GALE01" || SConfig::GetInstance().GetRevision() != 2)
+    return {};
+  const auto width = texture_info.GetRawWidth();
+  const auto height = texture_info.GetRawHeight();
+  if (!((width == 560 && height == 416) || (width == 280 && height == 208)))
+    return {};
+
+  const auto &memory = Core::System::GetInstance().GetMemory();
+  const auto *descriptor = memory.GetPointerForRange(0x804335B8, 0xA0);
+  if (!descriptor)
+    return {};
+  const auto plane = MeleeTextures::MatchEndingPlane({descriptor, 0xA0},
+                                                     texture_info.GetRawAddress(), width, height);
+  if (!plane)
+    return {};
+  const auto *source = memory.GetPointerForRange(plane->source_address, plane->source_size);
+  if (!source || source[0] != 0xFF || source[1] != 0xD8)
+    return {};
+  return fmt::format("tex1_still_{:016x}_{}", XXH64(source, plane->source_size, 0), plane->channel);
+}

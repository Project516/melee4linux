+// The Melee mapping shared with the Mac port. Face buttons follow Dolphin's
+// SDL gamepad names. The D-pad moves like the stick; keyboard keys use
+// Dolphin's X11 key names.
+void WriteGameCubeMapping(std::ofstream &output, const std::string &device,
+                          std::size_t port) {
+  struct Mapping {
+    const char *control;
+    const char *gamepad;
+    const char *keyboard;
+  };
+  static constexpr Mapping mappings[] = {
+      {"Buttons/A", "`Button A`", "J"},
+      {"Buttons/B", "`Button B`", "K"},
+      {"Buttons/X", "`Button X`", "space"},
+      {"Buttons/Y", "`Button Y`", "U"},
+      {"Buttons/Z", "`Shoulder R`", "O"},
+      {"Buttons/Start", "Start", "Return"},
+      {"Main Stick/Up", "`Left Y+` | `Pad N`", "W"},
+      {"Main Stick/Down", "`Left Y-` | `Pad S`", "S"},
+      {"Main Stick/Left", "`Left X-` | `Pad W`", "A"},
+      {"Main Stick/Right", "`Left X+` | `Pad E`", "D"},
+      {"C-Stick/Up", "`Right Y+`", "Up"},
+      {"C-Stick/Down", "`Right Y-`", "Down"},
+      {"C-Stick/Left", "`Right X-`", "Left"},
+      {"C-Stick/Right", "`Right X+`", "Right"},
+      {"Triggers/L", "`Trigger L`", "Q"},
+      {"Triggers/R", "`Trigger R`", "E"},
+      {"Triggers/L-Analog", "`Trigger L`", "Q"},
+      {"Triggers/R-Analog", "`Trigger R`", "E"},
+      {"D-Pad/Up", "", "T"},
+      {"D-Pad/Down", "", "G"},
+      {"D-Pad/Left", "", "F"},
+      {"D-Pad/Right", "", "H"},
+      {"Rumble/Motor", "`Motor L` | `Motor R`", ""},
+  };
+  const bool keyboard = device == KEYBOARD_DEVICE;
+  for (const Mapping &mapping : mappings) {
+    std::string expression = keyboard ? mapping.keyboard : mapping.gamepad;
+    if (!keyboard && port == 0 && *mapping.keyboard != '\0') {
+      expression += expression.empty() ? "" : " | ";
+      expression += "`" + std::string(KEYBOARD_DEVICE) + ":" + mapping.keyboard + "`";
+    }
+    if (!expression.empty())
+      output << mapping.control << " = " << expression << '\n';
+  }
+  output << "Main Stick/Calibration = 100.00\n"
+            "Main Stick/Dead Zone = 10.0\n"
+            "C-Stick/Calibration = 100.00\n"
+            "C-Stick/Dead Zone = 10.0\n"
+            // Gamepad triggers have no separate click. The last 10 percent of
+            // travel gives the GameCube trigger's digital press.
+            "Triggers/Dead Zone = 0.0\n"
+            "Triggers/Threshold = 90.0\n";
+}
+#endif

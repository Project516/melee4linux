+#if defined(__linux__)
+// Melee for Linux compiles the native game module from the extracted disc with
+// the bundled tools. The builder reports progress through a key=value file.
+void ReadImportStatus(const fs::path& status_path, ExtractionState* state)
+{
+  std::ifstream input(status_path);
+  std::string line;
+  std::string message;
+  std::string error;
+  unsigned completed = 0;
+  unsigned total = 0;
+  while (std::getline(input, line))
+  {
+    const std::size_t separator = line.find('=');
+    if (separator == std::string::npos)
+      continue;
+    const std::string_view key(line.data(), separator);
+    const std::string value = line.substr(separator + 1);
+    if (key == "message")
+      message = value;
+    else if (key == "completed")
+      completed = static_cast<unsigned>(std::strtoul(value.c_str(), nullptr, 10));
+    else if (key == "total")
+      total = static_cast<unsigned>(std::strtoul(value.c_str(), nullptr, 10));
+    else if (key == "error")
+      error = value;
+  }
+  if (message.empty())
+    return;
+  state->completed = completed;
+  state->total = std::max(1u, total);
+  std::lock_guard lock(state->mutex);
+  state->status = message;
+  if (!error.empty())
+    state->error = error;
+}
+
+bool BuildNativeModule(const fs::path& game, const fs::path& user_directory,
+                       const fs::path& release_directory, ExtractionState* state)
+{
+  auto fail = [&](std::string message)
+  {
+    std::lock_guard lock(state->mutex);
+    state->error = std::move(message);
+    state->running = false;
+    return false;
+  };
+  const fs::path builder = release_directory / "melee-import-game";
+  std::error_code ec;
+  if (!fs::is_regular_file(builder, ec))
+    return fail("The module builder is missing: " + builder.string());
+  const fs::path status_path = user_directory / "Setup" / "import-status.txt";
+  const fs::path log_path = user_directory / "Logs" / "melee-import.log";
+  fs::create_directories(status_path.parent_path(), ec);
+  fs::create_directories(log_path.parent_path(), ec);
+  fs::remove(status_path, ec);
+  {
+    std::lock_guard lock(state->mutex);
+    state->status = "Preparing the native game module";
+  }
+  state->completed = 0;
+  state->total = 1;
+  const std::array<std::string, 7> storage = {builder.string(),      "--game",   game.string(),
+                                              "--user-dir",          user_directory.string(),
+                                              "--status",            status_path.string()};
+  std::array<const char*, 8> arguments{};
+  for (std::size_t i = 0; i < storage.size(); ++i)
+    arguments[i] = storage[i].c_str();
+  SDL_Process* process = nullptr;
+  if (SDL_IOStream* log_stream = SDL_IOFromFile(log_path.string().c_str(), "w"))
+  {
+    if (const SDL_PropertiesID properties = SDL_CreateProperties())
+    {
+      SDL_SetPointerProperty(properties, SDL_PROP_PROCESS_CREATE_ARGS_POINTER, arguments.data());
+      SDL_SetNumberProperty(properties, SDL_PROP_PROCESS_CREATE_STDOUT_NUMBER,
+                            SDL_PROCESS_STDIO_REDIRECT);
+      SDL_SetPointerProperty(properties, SDL_PROP_PROCESS_CREATE_STDOUT_POINTER, log_stream);
+      SDL_SetBooleanProperty(properties, SDL_PROP_PROCESS_CREATE_STDERR_TO_STDOUT_BOOLEAN, true);
+      process = SDL_CreateProcessWithProperties(properties);
+      SDL_DestroyProperties(properties);
+    }
+    SDL_CloseIO(log_stream);
+  }
+  else
+  {
+    process = SDL_CreateProcess(arguments.data(), false);
+  }
+  if (!process)
+    return fail("Could not start the module builder: " + std::string(SDL_GetError()));
+  int exit_code = 1;
+  while (!SDL_WaitProcess(process, false, &exit_code))
+  {
+    SDL_Delay(200);
+    ReadImportStatus(status_path, state);
+  }
+  SDL_DestroyProcess(process);
+  ReadImportStatus(status_path, state);
+  if (exit_code != 0)
+  {
+    std::string error;
+    {
+      std::lock_guard lock(state->mutex);
+      error = state->error;
+    }
+    if (error.empty())
+      error = "The native module build failed.";
+    return fail(error + "\nLog: " + log_path.string());
+  }
+  return true;
+}
+#endif
